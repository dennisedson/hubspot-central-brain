# HubSpot Central Brain — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
#
# These names are consumed by src/scripts/script-env.ts (loadEnv), which every
# provisioning script imports. Scripts select a portal with PORTAL=dev|staging|prod
# (defaults to dev) and then read the matching HUBSPOT_<PORTAL>_* variables, so
# every portal you provision needs its own full set.
#
# Portal IDs themselves are NOT read from here — they are hardcoded in
# script-env.ts (PORTAL_IDS), alongside the per-portal app IDs.

# ---------------------------------------------------------------------------
# Per-portal credentials
# ---------------------------------------------------------------------------
# ACCOUNT_ID          Portal ID. Not used by the scripts; kept because the CI
#                     workflows reference the matching GitHub secret.
# PERSONAL_ACCESS_KEY Personal access key, for the hs CLI and SDK client init.
# SERVICE_KEY         Private app access token (pat-...). This is what the
#                     provisioning scripts authenticate their CRM calls with.
#                     If it 401s, regenerate the private app token in the portal.
# DEVELOPER_KEY       Developer API key. Required by the automation/v4 actions
#                     API, which OAuth tokens cannot call.
# SYNC_SECRET         Shared secret used to sign sync traffic between systems.

# Dev sandbox
HUBSPOT_DEV_ACCOUNT_ID=
HUBSPOT_DEV_PERSONAL_ACCESS_KEY=
HUBSPOT_DEV_SERVICE_KEY=
HUBSPOT_DEV_DEVELOPER_KEY=
HUBSPOT_DEV_SYNC_SECRET=

# Staging sandbox
HUBSPOT_STAGING_ACCOUNT_ID=
HUBSPOT_STAGING_PERSONAL_ACCESS_KEY=
HUBSPOT_STAGING_SERVICE_KEY=
HUBSPOT_STAGING_DEVELOPER_KEY=
HUBSPOT_STAGING_SYNC_SECRET=

# Production portal
HUBSPOT_PROD_ACCOUNT_ID=
HUBSPOT_PROD_PERSONAL_ACCESS_KEY=
HUBSPOT_PROD_SERVICE_KEY=
HUBSPOT_PROD_DEVELOPER_KEY=
HUBSPOT_PROD_SYNC_SECRET=

# ---------------------------------------------------------------------------
# External systems (not portal-scoped)
# ---------------------------------------------------------------------------
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
ASANA_API_KEY=
TELEMETRY_SECRET=

# ---------------------------------------------------------------------------
# NOTE: these are for LOCAL scripts only.
#
# The deployed serverless functions do NOT read this file. They read app secrets
# stored in HubSpot, set with `hs app secret add <NAME>`. Six are required, or
# functions fail at runtime:
#
#   HS_ACCESS_TOKEN  LINEAR_API_KEY  LINEAR_WEBHOOK_SECRET
#   ASANA_API_KEY    FELLOW_API_KEY  SYNC_SHARED_SECRET
#
# See the Setup section of README.md.
# ---------------------------------------------------------------------------
