    "labels": {
      "en": {
        "actionName": "Generate Video UTM Link",
        "appDisplayName": "Central Brain",
        "actionDescription": "Builds a UTM-tracked link from the video's Website URL and Campaign Name once it reaches the published stage, and writes it to the UTM Link property",
        "actionCardContent": "Generate UTM link for {{objectId}}",
        "inputFieldLabels": {
          "objectId": "Video Record ID",
          "destinationUrl": "Destination URL",
          "campaignName": "Campaign Name",
          "utmMedium": "Link Placement",
          "force": "Regenerate Existing Link"
        },
        "inputFieldDescriptions": {
          "objectId": "The Record ID (hs_object_id) of the Video to build a tracked link for",
          "destinationUrl": "The landing page the link should point at. Leave blank to use the video's Website URL property.",
          "campaignName": "The campaign this video's traffic belongs to. Leave blank to use the video's Campaign Name property.",
          "utmMedium": "Where the link will be placed. Becomes utm_medium. Defaults to Video Description.",
          "force": "By default a video that already has a UTM Link is skipped, because that string is already pasted into a published description. Choose Yes to rebuild it, and to run before the video reaches the published stage."
        },
        "outputFieldLabels": {
          "attributionStatus": "Attribution Status",
          "utmLink": "UTM Link",
          "campaign": "Campaign Slug",
          "medium": "Link Placement",
          "reason": "Reason"
        }
      }
