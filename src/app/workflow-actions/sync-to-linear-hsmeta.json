    "labels": {
      "en": {
        "actionName": "Sync Status to Linear",
        "appDisplayName": "Central Brain",
        "actionDescription": "Pushes the current HubSpot pipeline stage to the linked Linear issue, or creates the issue when the record has none and has reached Outline",
        "actionCardContent": "Sync to Linear → {{objectType}}",
        "inputFieldLabels": {
          "sharedSecret": "Shared Secret",
          "linearIssueId": "Linear Issue ID",
          "hubspotStage": "HubSpot Pipeline Stage",
          "objectType": "Object Type",
          "linearTeamId": "Linear Team ID",
          "title": "Content Title",
          "objectId": "HubSpot Record ID"
        },
        "inputFieldDescriptions": {
          "sharedSecret": "Shared secret that authenticates this request; must match the SYNC_SHARED_SECRET function secret",
          "linearIssueId": "The linear_issue_id property from the HubSpot record. Empty on a record promoted from the vault — the action then creates the issue instead of updating one",
          "hubspotStage": "The hs_pipeline_stage property from the HubSpot record",
          "objectType": "Whether this is a Content or Changelog Entry record",
          "linearTeamId": "Your Linear team ID — find it in Linear Settings > API",
          "title": "The title property from the HubSpot record — used as the Linear issue title when creating a new issue",
          "objectId": "The hs_object_id of the enrolled HubSpot record — used to write the new Linear issue id back after creation. Without it every later stage change creates another issue"
        },
        "outputFieldLabels": {
          "syncStatus": "Sync Status",
          "linearStateName": "Linear State Set",
          "linearIssueId": "Linear Issue ID",
          "linearIssueUrl": "Linear Issue URL"
        }
      }
    }
