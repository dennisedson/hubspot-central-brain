{
  "uid": "sync_to_asana_v1",
  "type": "workflow-action",
  "config": {
    "actionUrl": "${SYNC_TO_ASANA_URL}",
    "isPublished": true,
    "supportedClients": [{ "client": "WORKFLOWS" }],
    "objectTypes": [],
    "inputFields": [
      {
        "typeDefinition": {
          "name": "sharedSecret",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": true
      },
      {
        "typeDefinition": {
          "name": "title",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["OBJECT_PROPERTY"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "existingAsanaTaskUrl",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["OBJECT_PROPERTY"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "linearIssueUrl",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["OBJECT_PROPERTY"],
        "isRequired": true
      },
      {
        "typeDefinition": {
          "name": "hubspotStage",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["OBJECT_PROPERTY"],
        "isRequired": true
      },
      {
        "typeDefinition": {
          "name": "objectId",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": ["OBJECT_PROPERTY"],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "objectType",
          "type": "enumeration",
          "fieldType": "select",
          "options": [
            { "value": "content", "label": "Content" },
            { "value": "changelog", "label": "Changelog Entry" }
          ]
        },
        "supportedValueTypes": ["STATIC_VALUE"],
        "isRequired": true
      }
    ],
    "outputFields": [
      {
        "typeDefinition": { "name": "syncStatus", "type": "string", "fieldType": "text" }
      },
      {
        "typeDefinition": { "name": "asanaTaskGid", "type": "string", "fieldType": "text" }
      },
      {
        "typeDefinition": { "name": "asanaTaskUrl", "type": "string", "fieldType": "text" }
      }
    ],
    "labels": {
      "en": {
        "actionName": "Sync Stage to Asana",
        "appDisplayName": "Central Brain",
        "actionDescription": "Pushes the current HubSpot pipeline stage to the linked Asana task",
        "actionCardContent": "Sync to Asana → {{objectType}}",
        "inputFieldLabels": {
          "sharedSecret": "Shared Secret",
          "objectId": "HubSpot Record ID",
          "title": "Content Title",
          "existingAsanaTaskUrl": "Existing Asana Task URL",
          "linearIssueUrl": "Linear Issue URL",
          "hubspotStage": "HubSpot Pipeline Stage",
          "objectType": "Object Type"
        },
        "inputFieldDescriptions": {
          "sharedSecret": "Shared secret that authenticates this request; must match the SYNC_SHARED_SECRET function secret",
          "objectId": "The hs_object_id of the enrolled HubSpot record — used to write the Asana task URL back after creation",
          "title": "The title property from the HubSpot record — used as the Asana task name when creating a new task",
          "existingAsanaTaskUrl": "The asana_task_url property from the HubSpot record — if set, the task is updated directly without searching",
          "linearIssueUrl": "The linear_issue_url property from the HubSpot record — used to look up the Asana task if no asana_task_url is stored",
          "hubspotStage": "The hs_pipeline_stage property from the HubSpot record",
          "objectType": "Whether this is a Content or Changelog Entry record"
        },
        "outputFieldLabels": {
          "syncStatus": "Sync Status",
          "asanaTaskGid": "Asana Task GID",
          "asanaTaskUrl": "Asana Task URL"
        }
      }
    }
  }
}
