{
  "name": "hubspot-central-brain",
  "version": "0.1.0",
  "private": true,
  "description": "HubSpot Central Brain — hub-and-spoke system for developer advocacy",
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:cards": "npm --prefix src/app/cards install --silent && (cd src/app/cards && npx tsc --noEmit)",
    "typecheck:pages": "npm --prefix src/app/pages install --silent && (cd src/app/pages && npx tsc --noEmit)",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run typecheck:cards && npm run typecheck:pages && npm run typecheck:settings",
    "provision": "tsx src/scripts/provision-objects.ts",
    "provision:app-settings": "tsx src/scripts/provision-app-settings.ts",
    "provision:asana-property": "tsx src/scripts/provision-asana-property.ts",
    "provision:asana-sync-token": "tsx src/scripts/provision-asana-sync-token.ts",
    "provision:asana-test-project": "tsx src/scripts/provision-asana-test-project.ts",
    "patch:unique-property": "tsx src/scripts/patch-unique-property.ts",
    "provision:workflows": "tsx src/scripts/provision-workflows.ts",
    "provision:fellow-sync": "tsx src/scripts/provision-fellow-sync.ts",
    "provision:youtube-config": "tsx src/scripts/provision-youtube-config.ts",
    "provision:associations": "tsx src/scripts/provision-associations.ts",
    "provision:enterpret-quotes": "tsx src/scripts/provision-enterpret-quotes.ts",
    "provision:property-descriptions": "tsx src/scripts/provision-property-descriptions.ts",
    "provision:asana-webhook": "tsx src/scripts/provision-asana-webhook.ts",
    "build": "npm run sync:settings-form && esbuild src/app/functions/*.ts --bundle --platform=node --target=node18 --outdir=src/app/functions",
    "dev": "hs project dev",
    "upload": "npm run build && hs project upload",
    "upload:dev": "npm run build && hs project upload --account=Dev-HubSpot-Brain",
    "upload:prod": "npm run build && .github/scripts/upload-to-portal.sh 22047910 DevRelTeamHub",
    "preflight": "tsx src/scripts/preflight.ts",
    "backfill:linear": "tsx src/scripts/backfill-linear.ts",
    "provision:backfill-state": "tsx src/scripts/provision-backfill-state.ts",
    "provision:project-map": "tsx src/scripts/provision-project-map.ts",
    "provision:changelog-drafting": "tsx src/scripts/provision-changelog-drafting.ts",
    "compare:changelog-models": "tsx src/scripts/compare-changelog-models.ts",
    "typecheck:settings": "npm --prefix src/app/settings install --silent && (cd src/app/settings && npx tsc --noEmit)",
    "sync:settings-form": "tsx src/scripts/sync-settings-form.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@hubspot/cli": "^8.14.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@hubspot/api-client": "^12.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
